# Optional overrides. Copy only the options you actually need into .env.local.
# Do not append this entire file: the native and compatible profiles are alternatives.
AI_CHAT_PROVIDER=deepseek
AI_CHAT_MODEL=deepseek-flash
AI_VISION_PROVIDER=deepseek
# Independent upload moderation model; changing chat does not change this default.
AI_VISION_MODEL=deepseek-flash
# AI_CHAT_BASE_URL=https://api.deepseek.com
# AI_CHAT_API_KEY=
# AI_VISION_BASE_URL=https://api.deepseek.com
# AI_VISION_API_KEY=
# Legacy alias: DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_IMAGE_PROVIDER=openrouter
AI_IMAGE_MODEL=openai/gpt-image-2
# AI_IMAGE_BASE_URL=https://openrouter.ai/api/v1
# AI_IMAGE_API_KEY=
# Legacy shared image/Gemini alias: OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_TTS_PROVIDER=qwen-audio
# AI_TTS_MODEL=qwen-audio-3.1-tts-flash
# AI_TTS_MODEL overrides the selected primary speech model, not Qwen's Gemini fallback.
# With only OPENROUTER_API_KEY, default TTS is openrouter-gemini.
DASHSCOPE_TTS_BASE_URL=https://maas.qianwenaiapi.com/api/v1
DASHSCOPE_EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DASHSCOPE_AUDIO_HOST_SUFFIX=.aliyuncs.com
AI_EMBEDDING_PROVIDER=dashscope
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_SEND_DIMENSIONS=true
# AI_TTS_BASE_URL=https://maas.qianwenaiapi.com/api/v1
# AI_TTS_API_KEY=
# AI_EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# AI_EMBEDDING_API_KEY=
# Canonical per-capability URL/key overrides win over matching native aliases.
# New protocol/endpoint/model/dimension vectors rebuild without deleting facts/FTS.

# Alternative OpenAI-compatible profile. Uncomment only capabilities you need.
# Each selected compatible capability requires an explicit BASE_URL and MODEL.
# Replace all example URLs/models; set the corresponding key if authentication is needed.
# Compatible profiles never inherit DEEPSEEK/OPENROUTER/DASHSCOPE_API_KEY.
# No query strings, fragments or URL-embedded username/password are allowed.
# AI_CHAT_PROVIDER=openai-compatible
# AI_CHAT_BASE_URL=http://127.0.0.1:1234/v1
# AI_CHAT_MODEL=your-chat-model
# AI_CHAT_API_KEY=
# Vision inherits compatible chat when vision provider is omitted or openai-compatible.
# A changed vision URL does not inherit the chat key; supply its own key if needed.
# Optional separate multimodal connection (remove the native vision lines above):
# AI_VISION_PROVIDER=openai-compatible
# AI_VISION_BASE_URL=http://127.0.0.1:1234/v1
# AI_VISION_MODEL=your-multimodal-model
# AI_VISION_API_KEY=
# AI_IMAGE_PROVIDER=openai-compatible
# AI_IMAGE_BASE_URL=https://your-image-service.example/v1
# AI_IMAGE_MODEL=your-image-model
# AI_IMAGE_API_KEY=
# Needs synchronous Base64 images and /images/edits with reference images for photos.
# AI_TTS_PROVIDER=openai-compatible
# AI_TTS_BASE_URL=https://your-speech-service.example/v1
# AI_TTS_MODEL=your-speech-model
# AI_TTS_API_KEY=
# AI_TTS_VOICE_FEMALE=alloy
# AI_TTS_VOICE_MALE=onyx
# Uses /audio/speech MP3/WAV, not the 25-voice Qwen catalog or automatic fallback.
# AI_EMBEDDING_PROVIDER=openai-compatible
# AI_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# AI_EMBEDDING_MODEL=your-embedding-model
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_DIMENSIONS=1024
# Set false if the endpoint rejects the optional dimensions parameter; the response
# still must contain the configured dimension count (e.g. set 768 for a 768-D model).
# AI_EMBEDDING_SEND_DIMENSIONS=false
# API key rotation does not rebuild vectors. Restart app and worker after edits.


# SMTP forwarding: use your mailbox provider's app password.
# EMAIL_PROVIDER=smtp
# LETTER_DELIVERY=both
# EMAIL_FROM=you@your-domain.example
# EMAIL_REPLY_TO=you@your-domain.example
# SMTP_HOST=smtp.your-mailbox.example
# SMTP_PORT=587
# SMTP_USER=you@your-domain.example
# SMTP_PASSWORD=
# 465 uses implicit TLS; 587 requires STARTTLS. Certificate verification stays on.

# Resend is optional for users who already have a verified sending domain.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=you@your-domain.example
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# Public signed unsubscribe links require the same HTTPS origin as APP_BASE_URL.
# LETTER_PUBLIC_BASE_URL=https://your-personal-host.example

# Local storage is private in development and production.
# Explicit optional R2 profile (cloud objects follow your bucket/public URL policy):
# OBJECT_STORAGE_PROVIDER=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
