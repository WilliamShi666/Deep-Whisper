    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "undici": "6.29.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5",
    "better-sqlite3": "12.8.0",
    "nodemailer": "10.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-import": "^2.32.0",
    "shadcn": "latest",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/nodemailer": "7.0.11"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "fast-xml-parser": "^5.7.0",
      "lodash": "^4.18.0",
      "@babel/core": "^7.29.6",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "source-map-js": "^1.2.2"
    }
  }
