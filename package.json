{
  "name": "deep-whisper-personal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "tsx scripts/personal/start.ts dev",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "lint:style": "stylelint \"src/**/*.css\"",
    "start": "tsx scripts/personal/start.ts start",
    "test:e2e": "tsx scripts/personal/e2e.ts",
    "test:unit": "tsx scripts/run-unit-tests.ts",
    "test:memory": "tsx --require ./tests/helpers/server-only.cjs --test tests/memory-*.test.ts",
    "test:prefs": "tsx --require ./tests/helpers/server-only.cjs --test tests/communication-prefs.test.ts",
    "test:providers": "tsx --require ./tests/helpers/server-only.cjs --test tests/*provider*.test.ts tests/*registry.test.ts tests/*speech*.test.ts tests/photo-generation-policy.test.ts tests/live-canary-guard.test.ts tests/review-release-guards.test.ts",
    "test:deepseek:live": "tsx scripts/test-deepseek-live.ts",
    "test:image:live": "tsx scripts/test-openrouter-image-live.ts",
    "test:gemini-tts:live": "tsx scripts/test-openrouter-gemini-tts-live.ts",
    "test:qwen-tts:live": "tsx scripts/test-qwen-tts-live.ts",
    "tts:audition:qwen": "tsx scripts/qwen-tts-audition.ts",
    "report:openrouter:generation": "tsx scripts/report-openrouter-generation.ts",
    "test:wallpapers:final": "tsx --test tests/deepseek-wallpaper-plan.test.ts tests/deepseek-wallpaper-samples.test.ts && tsx scripts/check-deepseek-wallpaper-final.ts",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm dlx concurrently --group --names lint-tsc,lint-build,lint-style \"pnpm ts-check\" \"pnpm lint:build\" \"pnpm lint:style\"",
    "setup": "tsx scripts/personal/setup.ts",
    "doctor": "tsx scripts/personal/doctor.ts",
    "data:backup": "tsx scripts/personal/data.ts backup",
    "data:restore": "tsx scripts/personal/data.ts restore",
    "data:migrate": "tsx scripts/personal/data.ts migrate",
    "test:sqlite": "tsx --require ./tests/helpers/server-only.cjs --test tests/personal-*.test.ts",
    "test:personal": "tsx --require ./tests/helpers/server-only.cjs --test tests/personal-*.test.ts",
    "test": "pnpm test:unit",
    "export:personal": "tsx scripts/personal/export.ts"
  },
