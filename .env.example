# Deep Whisper Personal — Node 24 LTS + pnpm 9
# Default-provider minimum: obtain your key from https://platform.deepseek.com/api_keys
# DeepSeek is optional when configuring your own OpenAI-compatible chat service below.
DEEPSEEK_API_KEY=

# Optional photos and Gemini speech: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional Qwen speech + text-embedding-v4: Qianwen AI platform key.
# Default endpoints belong to maas.qianwenaiapi.com; a Bailian key is a different profile.
DASHSCOPE_API_KEY=

# Optional model IDs: uncomment only the overrides you need, then restart.
# These overrides keep the selected protocol; the model must support its API contract.
# AI_CHAT_MODEL=deepseek-flash
# AI_VISION_MODEL=deepseek-flash
# AI_IMAGE_MODEL=openai/gpt-image-2
# Qwen example (DASHSCOPE_API_KEY); for Gemini use google/gemini-3.1-flash-tts-preview.
# AI_TTS_MODEL=qwen-audio-3.1-tts-flash
# AI_EMBEDDING_MODEL=text-embedding-v4
# Embedding defaults to 1024 dimensions. Model/endpoint/dimension changes rebuild vectors.


# Alternative: your own OpenAI-compatible service (no DeepSeek key required).
# Uncomment and replace the URL/model. Keys are optional only for unauthenticated services.
# Root URL includes the API prefix (e.g. /v1), not /chat/completions.
# AI_CHAT_PROVIDER=openai-compatible
# AI_CHAT_BASE_URL=http://127.0.0.1:1234/v1
# AI_CHAT_MODEL=your-chat-model
# AI_CHAT_API_KEY=
# Vision inherits this chat connection/model unless overridden. Image chat/uploads
# require a multimodal model; text-only services still support text chat and memory.
# Photos/speech/embeddings can each use another compatible URL, key and model.
# See README.md / README.en.md and .env.advanced.example for a complete profile.

# Defaults work for one owner on this computer.
HOST=127.0.0.1
PORT=5000
APP_DATA_DIR=./data
APP_ACCESS_MODE=local
# APP_BASE_URL is derived from PORT in local mode.
# Remote use: APP_ACCESS_MODE=password, your HTTPS origin, and >=12 character password.
# OWNER_PASSWORD=
# APP_BASE_URL=https://your-personal-host.example

MEMORY_RETRIEVAL_MODE=auto
EMAIL_PROVIDER=none
LETTER_DELIVERY=in-app
# Enable station letters explicitly in companion settings after onboarding.
# SMTP or Resend forwarding is optional; recipient is saved in the app, never an EMAIL_TO env.
